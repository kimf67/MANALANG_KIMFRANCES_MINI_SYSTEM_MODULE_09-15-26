        print(f" (Same idea as sqrt({x}**2 + {y}**2 = "f"{math.sqrt(x**2 + y**2)}, but hypot() is more precise.)")

    elif choice == "0":
        return
    else:
        print("\nInvalid choice.")

    pause()

