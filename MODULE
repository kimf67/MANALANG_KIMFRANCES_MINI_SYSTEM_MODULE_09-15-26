import sys
import math
import random
import functools

print = functools.partial(print, flush=True)
#HELPER FUNCTIONS (used throughout the program)
def get_float(propmt):
    while True:
        try:
            print(prompt, end="", flush=True)
            sys.stdout.flout()
            return float(input())
        except ValueError:
            print(" >> Invalid input. Please type a number (e.g., 3, 3.5, -2).")
        except EOFError:
            print("\n >> No input received. Exiting program.")
            raise SystemExit
def get_int(propmt):
    while True:
        try:
            print(propmt, end="", flush=True)
            sys.stdout.flush()
            return int(input())
        except ValueError:
            print(" >> Invalid input. Please type a whole number (e.g., 5, 0.3, 0).")
        except EOFError:
            print(" >> No input received. Exiting program.")
            raise SystemExit

def pause():
